# ========================
# Konfigurasi Database
# ========================
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ========================
# Port Server (opsional)
# ========================
PORT=

# ========================
# Secret key (untuk JWT)
# ========================
SECRET=

# ========================
# OAuth2 (Google & Discord)
# ========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/oauth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:3000/auth/oauth/discord/callback

# Opsional: jika diset, callback akan redirect ke <URL>#token=<jwt> alih-alih mengembalikan JSON
OAUTH_FRONTEND_REDIRECT_URL=
# Opsional: deep link redirect aplikasi mobile (default: pathmobile://app/oauth/callback)
OAUTH_MOBILE_REDIRECT_URL=pathmobile://app/oauth/callback
# Opsional: daftar redirect_uri tambahan yang diizinkan, dipisahkan koma
OAUTH_ALLOWED_REDIRECT_URLS=

# ========================
# Server AI (HANYA DISIMPAN DI BACKEND)
# ========================
AI_API_URL=https://ai.pathclass.app
AI_API_KEY=

# ========================
# !! JANGAN DISENTUH !!
# ========================
DATABASE_URL="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} host=${POSTGRES_HOST}"
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=$DATABASE_URL
GOOSE_MIGRATION_DIR=./internal/db/migrations/

# ========================
# !! ZONA DOCKER !!
# ========================
DOCKER_POSTGRES_USER=
DOCKER_POSTGRES_PASSWORD=
DOCKER_POSTGRES_DB=
HOST_PORT=3001
DB_HOST_PORT=5433
# ========================
